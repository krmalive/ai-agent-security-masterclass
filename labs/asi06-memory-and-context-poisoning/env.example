# LLM Configuration
LLM_PROVIDER=requesty
LLM_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://router.requesty.ai/v1

# Application Mode — memory writes: defense runs MemoryValidator before add_to_memory; attack skips it
MODE=attack
# MODE=defense

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# ChromaDB
CHROMA_DB_PATH=/app/data/chroma_db
