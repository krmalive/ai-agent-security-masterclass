OPENAI_API_KEY=
OPENAI_API_BASE=https://router.requesty.ai/v1
LLM_MODEL=openai/gpt-4.1-mini
FLASK_ENV=development

# --- skill-scanner only (host / CI shell where you run `skill-scanner`, NOT read by Flask) ---
# The scanner does not use OPENAI_API_BASE; set base URL here or scans hit the wrong endpoint.
# SKILL_SCANNER_LLM_API_KEY=
# SKILL_SCANNER_META_LLM_API_KEY=
# SKILL_SCANNER_LLM_PROVIDER=openai
# SKILL_SCANNER_LLM_BASE_URL=https://router.requesty.ai/v1
# SKILL_SCANNER_LLM_MODEL=gpt-4.1-mini
# Optional if your gateway rejects json_schema responses:
# SKILL_SCANNER_LLM_FORCE_JSON_OBJECT=1
